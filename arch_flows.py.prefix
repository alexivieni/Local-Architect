    import arch_dataflow
    DATA_FLOWS = arch_dataflow.register(FLOWS, (core.load_config().get("flows") or {}).get("engine", "legacy"), say=lambda m: None)
except Exception as _ex:                                # a broken YAML must never take the engine down
    DATA_FLOWS = []


