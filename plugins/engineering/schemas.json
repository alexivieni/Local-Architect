{
 "schemas": {
  "code-review": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "summary": {
     "type": "string"
    },
    "critical_issues": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "file": {
        "type": "string"
       },
       "line": {
        "type": "integer"
       },
       "issue": {
        "type": "string"
       },
       "severity": {
        "type": "string",
        "enum": [
         "Critical",
         "High"
        ]
       }
      },
      "required": [
       "file",
       "line",
       "issue",
       "severity"
      ]
     }
    },
    "suggestions": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "file": {
        "type": "string"
       },
       "line": {
        "type": "integer"
       },
       "suggestion": {
        "type": "string"
       },
       "category": {
        "type": "string",
        "enum": [
         "Security",
         "Performance",
         "Correctness",
         "Maintainability"
        ]
       }
      },
      "required": [
       "file",
       "line",
       "suggestion",
       "category"
      ]
     }
    },
    "looks_good": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "verdict": {
     "type": "string",
     "enum": [
      "Approve",
      "Request Changes",
      "Needs Discussion"
     ]
    }
   },
   "required": [
    "title",
    "summary",
    "critical_issues",
    "suggestions",
    "looks_good",
    "verdict"
   ]
  },
  "debug": {
   "type": "object",
   "properties": {
    "issue_summary": {
     "type": "string"
    },
    "expected": {
     "type": "string"
    },
    "actual": {
     "type": "string"
    },
    "steps": {
     "type": "string"
    },
    "root_cause": {
     "type": "string"
    },
    "fix": {
     "type": "string"
    },
    "prevention_tests": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "prevention_guards": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "issue_summary",
    "expected",
    "actual",
    "steps",
    "root_cause",
    "fix",
    "prevention_tests",
    "prevention_guards"
   ]
  },
  "architecture": {
   "type": "object",
   "properties": {
    "number": {
     "type": "integer"
    },
    "title": {
     "type": "string"
    },
    "status": {
     "type": "string",
     "enum": [
      "Proposed",
      "Accepted",
      "Deprecated",
      "Superseded"
     ]
    },
    "date": {
     "type": "string"
    },
    "deciders": {
     "type": "string"
    },
    "context": {
     "type": "string"
    },
    "decision": {
     "type": "string"
    },
    "options": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "complexity": {
        "type": "string",
        "enum": [
         "Low",
         "Med",
         "High"
        ]
       },
       "cost": {
        "type": "string"
       },
       "scalability": {
        "type": "string"
       },
       "team_familiarity": {
        "type": "string"
       },
       "pros": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "cons": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "name",
       "complexity",
       "cost",
       "scalability",
       "team_familiarity",
       "pros",
       "cons"
      ]
     }
    },
    "tradeoff_analysis": {
     "type": "string"
    },
    "easier": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "harder": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "revisit": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "action_items": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "number",
    "title",
    "status",
    "date",
    "deciders",
    "context",
    "decision",
    "options",
    "tradeoff_analysis",
    "easier",
    "harder",
    "revisit",
    "action_items"
   ]
  },
  "deploy-checklist": {
   "type": "object",
   "properties": {
    "service": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "deployer": {
     "type": "string"
    },
    "customizations": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "section": {
        "type": "string",
        "enum": [
         "Pre-Deploy",
         "Deploy",
         "Post-Deploy"
        ]
       },
       "item": {
        "type": "string"
       }
      },
      "required": [
       "section",
       "item"
      ]
     }
    },
    "error_rate_pct": {
     "type": "number"
    },
    "p50_latency_ms": {
     "type": "number"
    },
    "critical_flow": {
     "type": "string"
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "service",
    "date",
    "deployer",
    "customizations",
    "error_rate_pct",
    "p50_latency_ms",
    "critical_flow",
    "notes"
   ]
  },
  "documentation": {
   "type": "object",
   "properties": {
    "doc_type": {
     "type": "string",
     "enum": [
      "README",
      "API Documentation",
      "Runbook",
      "Architecture Doc",
      "Onboarding Guide"
