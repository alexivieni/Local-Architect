    "title": {
     "type": "string"
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "key": {
        "type": "string",
        "enum": [
         "what",
         "quickstart",
         "config",
         "contributing",
         "endpoints",
         "auth",
         "ratelimits",
         "sdk",
         "when",
         "prereqs",
         "procedure",
         "rollback",
         "escalation",
         "context",
         "design",
         "decisions",
         "dataflow",
         "setup",
         "systems",
         "tasks",
         "contacts"
        ]
       },
       "body": {
        "type": "string"
       }
      },
      "required": [
       "key",
       "body"
      ]
     }
    }
   },
   "required": [
    "doc_type",
    "title",
    "sections"
   ]
  },
  "incident-status": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "severity": {
