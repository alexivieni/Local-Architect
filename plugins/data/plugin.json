      "sql-queries",
      "statistical-analysis",
      "validate-data",
      "write-query"
    ],
    "command_workflow": {
      "analyze": "data:analyze",
      "build-dashboard": "data:build-dashboard",
      "create-viz": "data:create-viz",
      "data-context-extractor": "data:data-context-extractor",
      "data-visualization": "data:data-visualization",
      "explore-data": "data:explore-data",
      "sql-queries": "data:sql-queries",
      "statistical-analysis": "data:statistical-analysis",
      "validate-data": "data:validate-data",
      "write-query": "data:write-query"
    }
  }
}