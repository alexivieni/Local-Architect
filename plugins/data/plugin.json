{
  "name": "data",
  "version": "1.1.0",
  "description": "Write SQL, explore datasets, validate analyses, build charts and dashboards with the local models: the Anthropic data plugin's ten skills as local commands, skills and agent workflows.",
  "author": "Adapted for Architect from Anthropic's knowledge-work-plugins/data (Apache-2.0)",
  "requires": {
    "architect": ">=13",
    "tiers": [
      "worker"
    ]
  },
  "provides": {
